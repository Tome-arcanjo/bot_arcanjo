# Variaveis de ambiente - Copie este arquivo para .env e preencha com suas chaves

# Servidor
PORT=3000
NODE_ENV=development

# Provedor de IA padrao: "openai" ou "anthropic"
AI_PROVIDER=anthropic

# Chaves de API
OPENAI_API_KEY=sua_chave_openai_aqui
ANTHROPIC_API_KEY=sua_chave_anthropic_aqui

# Modelos
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Configuracoes do Chat
MAX_TOKENS=1024
SYSTEM_PROMPT=Voce e o Arcanjo, um assistente inteligente, prestativo e amigavel. Responda sempre em portugues.

# Banco de dados (Supabase)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=sua_service_role_key_aqui

# WhatsApp API
WHATSAPP_TOKEN=EAAxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=12345678
WHATSAPP_VERIFY_TOKEN=meu_token_secreto
