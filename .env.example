# Variaveis de ambiente - Copie este arquivo para .env e preencha com suas chaves

# Servidor
PORT=3000
NODE_ENV=development

# Provedor de IA padrao: "openai" ou "anthropic"
AI_PROVIDER=anthropic

# Chaves de API
OPENAI_API_KEY=sua_chave_openai_aqui

# Modelos
OPENAI_MODEL=gpt-4o-mini

# Configuracoes do Chat
MAX_TOKENS=1024
SYSTEM_PROMPT=Voce e o Arcanjo, um assistente inteligente, prestativo e amigavel. Responda sempre em portugues.

# Banco de dados (Supabase)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=sua_service_role_key_aqui
# Opcional: connection string direta do Postgres (Supabase > Project Settings >
# Database > Connection string > URI). Usada apenas por "npm run db:migrate"
# para rodar o init.sql automaticamente. Sem ela, o script apenas imprime as
# instruções para rodar o SQL manualmente no Supabase SQL Editor.
DATABASE_URL=

# WhatsApp API
WHATSAPP_TOKEN=EAAxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=12345678
WHATSAPP_VERIFY_TOKEN=meu_token_secreto
# App Secret do App da Meta (Configurações do App > Básico > Chave Secreta do
# Aplicativo). Usado para validar a assinatura X-Hub-Signature-256 de cada
# requisição do webhook e confirmar que ela realmente veio da Meta.
# OBRIGATÓRIO: sem ele o webhook recusa todas as mensagens (HTTP 503).
WHATSAPP_APP_SECRET=
# Versão da Graph API usada nas chamadas (verifique periodicamente em
# https://developers.facebook.com/docs/graph-api/changelog quais versões
# ainda estão ativas — versões antigas são desativadas pela Meta com o tempo).
WHATSAPP_API_VERSION=v22.0

# Login do painel
# Cada funcionário entra com o próprio e-mail e senha (tabela users, gerenciada
# em Usuários pelo admin). Estas duas variáveis são o ACESSO DE EMERGÊNCIA:
# um admin fixo, fora do banco, para criar o primeiro usuário ou recuperar o
# acesso se ninguém conseguir entrar. Na tela de login, digite o
# ADMIN_USERNAME no campo "E-mail".
ADMIN_USERNAME=admin
# Hash bcrypt da senha — NUNCA coloque a senha em texto puro aqui.
# Gere com: node scripts/gerar-senha.js "sua_senha_aqui"
ADMIN_PASSWORD_HASH=
# String aleatória usada para assinar o cookie de sessão. Gere uma com:
# openssl rand -hex 32
# OBRIGATÓRIO em produção (NODE_ENV=production): o servidor não sobe sem ele.
SESSION_SECRET=
# Cookie de login com a flag "Secure":
#   auto  (padrão) = Secure só quando o proxy informa HTTPS (X-Forwarded-Proto).
#                    Se o proxy informar http, o login funciona mesmo assim e o
#                    log avisa — corrija o Nginx/Cloudflare e depois use "true".
#   true  = sempre Secure (recomendado com o proxy configurado certo).
#   false = nunca Secure (só para testes locais sem HTTPS).
COOKIE_SECURE=auto
# Quantos proxies na frente do app são confiáveis para ler X-Forwarded-*.
# 1 = só o Nginx (padrão). Veja o README (seção Nginx/Cloudflare).
TRUST_PROXY=1

# Ligações com o advogado (CRM)
# O aviso de "ligação atrasada" aparece no navegador (painel aberto): notificação,
# som e banner, 1 aviso ao passar do horário e repetido a cada 30 min por 3 h.
# OPCIONAL — além disso, mandar o aviso no WhatsApp: números com DDI, só dígitos,
# separados por vírgula. Coloque o número real só no .env (este arquivo vai pro git).
# Obs.: a Meta só entrega texto livre a quem falou com o bot nas últimas 24 h.
CALL_ALERT_PHONES=
# Fuso horário usado nos horários das mensagens (padrão: America/Sao_Paulo).
APP_TIMEZONE=America/Sao_Paulo
